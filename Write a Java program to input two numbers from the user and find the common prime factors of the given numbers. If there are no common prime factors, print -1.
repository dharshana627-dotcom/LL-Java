import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n1 = sc.nextInt();
        int n2 = sc.nextInt();
        int fou=0;
        for(int i=2;i<=n1;i++){
            if(n1%i==0 && n2%i==0){
                int count=0;
                for(int j=1;j<=i;j++){
                    if(i%j==0){
                        count++;
                    }
                }
                if(count==2){
                    System.out.print(i+" ");
                    fou=1;
                }
            }
        }
        if(fou!=1){
            System.out.println("-1");
        }
    }
}

