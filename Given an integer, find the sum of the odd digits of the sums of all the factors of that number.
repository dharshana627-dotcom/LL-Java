import java.util.*;
public class Main{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum=0;
        for(int i=1;i<=n;i++){
            if(n%i==0){
                sum=sum+i;
            }
        }
        int rem=0;
        while(sum>0){
            int digit=sum%10;
            if(digit%2!=0){
                rem=rem+digit;
            }
            sum=sum/10;
        }
        System.out.println(rem);
    }
}

Input:
25
Expected Output:
4
