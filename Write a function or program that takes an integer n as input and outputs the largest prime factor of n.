import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        long prime = -1;
        for (long i=2;i*i<=n;i++) {
            while(n%i==0) {
                prime =i;
                n/=i;
            }
        }
        if (n>1) {
            prime=n;
        }
        System.out.println(prime);
    }
}

Input:
10
Expected Output:
5
