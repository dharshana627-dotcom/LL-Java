import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int q = sc.nextInt();
        for(int i=0;i<q;i++){
            int n = sc.nextInt();
            int rem=0;
            for(int j=1;j<=n;j++){
                if(n%j==0){
                    int num=j;
                    while(num>0){
                        int digit=num%10;
                        if(digit%2!=0){
                            rem+=digit;
                        }
                        num=num/10;
                    }
                }
            }
            System.out.println(rem);
        }
    }
}

