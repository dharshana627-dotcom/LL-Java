import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int count=0,group=1,num=1;
        while(count<n){
            for(int i=0;i<group && count<n;i++){
                System.out.print(num+" ");
                num+=2;
                count++;
            }
            num--;
            group++;
        }
    }
}

