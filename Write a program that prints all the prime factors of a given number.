import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        boolean first = true;
        for (long i=2;i*i<=n;i++) {
            while (n%i==0) {
                if (!first) {
                    System.out.print(" ");
                }
                System.out.print(i);
                first=false;
                n/=i;
            }
        }
        if (n>1) {
            if (!first) {
                System.out.print(" ");
            }
            System.out.print(n);
        }
    }
}

Input:
10
Expected Output:
2 5
