import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        long a = sc.nextLong();
        long b = sc.nextLong();
        long pow=1;
        for(int i=0;i<b;i++){
            pow*=a;
        }
        System.out.println(pow);
    }
}

