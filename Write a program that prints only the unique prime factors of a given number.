import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long num = sc.nextLong();
        boolean first=true;
        for (long i=2;i*i<=num;i++) {
            if (num%i==0) {
                if (!first) {
                    System.out.print(" ");
                }
                System.out.print(i);
                first = false;
                while(num%i==0) {
                    num/=i;
                }
            }
        }
        if (num>1) {
            if (!first) {
                System.out.print(" ");
            }
            System.out.print(num);
        }
    }
}

Input:
10
Expected Output:
2 5
