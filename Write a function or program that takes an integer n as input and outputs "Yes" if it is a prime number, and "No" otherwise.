import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        if (n<=1) {
            System.out.println("No");
            return;
        }
        int count = 0;
        for(long i=1;i*i<=n;i++) {
            if(n%i==0) {
                if(i*i==n) {
                    count+=1;
                }else{
                    count+=2;
                }
            }
        }
        if(count==2) {
            System.out.println("Yes");
        }else {
            System.out.println("No");
        }
    }
}

