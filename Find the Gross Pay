import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int hrs = sc.nextInt();
        double rate = sc.nextDouble();
        
        double w=hrs*rate;
        double m=(hrs*rate*52)/12;
        double a=hrs*rate*52;
        
        System.out.printf("Weekly Gross Pay: %.1f%n", w);
        System.out.printf("Monthly Gross Pay: %.1f%n", m);
        System.out.printf("Annual Gross Pay: %.1f%n", a);
    }
}

