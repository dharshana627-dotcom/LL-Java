import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        long p = sc.nextLong();
        long count=0,res=0;
        for(long i=n;i>=1;i--) {
            if(n%i==0) {
                count++;
                if (count==p) {
                    res=i;
                    break;
                }
            }
        }
        System.out.println(res);
    }
}

Input:
10 2
Expected Output:
5
