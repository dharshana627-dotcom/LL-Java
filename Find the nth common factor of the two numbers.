import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n1 = sc.nextLong();
        long n2 = sc.nextLong();
        long p = sc.nextLong();
        long count=0,res=0,min=0;
        if(n1<n2){
            min=n1;
        }else{
            min=n2;
        }
        for(long i=1;i<=min;i++) {
            if(n1%i==0 && n2%i==0) {
                count++;
                if (count==p) {
                    res=i;
                    break;
                }
            }
        }
        System.out.println(res);
    }
}

Input:
10 20 2
Expected Output:
2
